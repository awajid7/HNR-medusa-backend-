# Copy to deploy/.env and fill in.
# Without your own domain yet, use sslip.io names built from the server's
# public IP, e.g. api.129-151-1-2.sslip.io and shop.129-151-1-2.sslip.io
API_DOMAIN=api.hnrbyraza.com
SHOP_DOMAIN=shop.hnrbyraza.com
# Optional, space separated: other names that redirect to SHOP_DOMAIN
EXTRA_SHOP_DOMAINS=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
REVALIDATE_SECRET=

# Printed by the seed step (step 6 in deploy/README.md)
PUBLISHABLE_KEY=

# Order emails through Resend (free: 3,000 a month). Without a key, emails are only logged.
RESEND_API_KEY=
# RESEND_FROM="H&R by Raza <order@hnrbyraza.com>"
# ORDER_NOTIFY_EMAIL=sales@hnrbyraza.com
