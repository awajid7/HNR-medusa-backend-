# Local development defaults. On Railway, set these as service variables.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa_hnr
REDIS_URL=redis://localhost:6379

# Public URL of this backend (used for admin and for product image URLs)
MEDUSA_BACKEND_URL=http://localhost:9000

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:5173,http://localhost:8000

# Use long random strings in production
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Optional: S3-compatible storage (e.g. Cloudflare R2) for images uploaded in the admin.
# Without it, uploads are stored on the server's disk, which Railway wipes on redeploy.
# S3_BUCKET=
# S3_FILE_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=

# Order emails (optional). Without RESEND_API_KEY they are only logged.
RESEND_API_KEY=
RESEND_FROM="H&R by Raza <order@hnrbyraza.com>"
ORDER_NOTIFY_EMAIL=sales@hnrbyraza.com
STORE_URL=http://localhost:8000
